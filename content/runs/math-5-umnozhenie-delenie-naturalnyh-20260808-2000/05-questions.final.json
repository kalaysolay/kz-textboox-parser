      "explanationRu": "По учебнику $a$ и $b$ — множители, $c$ — значение произведения.",
      "explanationKk": "Оқулық бойынша $a$ мен $b$ — көбейткіштер, $c$ — көбейтіндінің мәні.",
      "source": "Алдамуратова, 5 кл, ч.1, стр. 24-27",
      "options": [
        {
          "label": "A",
          "textRu": "делимым и делителем",
          "textKk": "бөлінгіш және бөлгіш",
          "correct": false
        },
        {
          "label": "B",
          "textRu": "множителями",
          "textKk": "көбейткіштер",
          "correct": true
        },
        {
          "label": "C",
          "textRu": "слагаемыми",
          "textKk": "қосылғыштар",
          "correct": false
        },
        {
          "label": "D",
          "textRu": "значением произведения",
          "textKk": "көбейтіндінің мәні",
          "correct": false
        }
      ],
      "fillAnswers": [],
      "illustration": null
    },
    {
