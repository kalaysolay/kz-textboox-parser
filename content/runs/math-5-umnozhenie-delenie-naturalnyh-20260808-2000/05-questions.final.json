          "correct": true
        },
        {
          "label": "B",
          "textRu": "Бассейн наполнится за $4$ часа",
          "textKk": "Бассейн $4$ сағатта толады",
          "correct": true
        },
        {
          "label": "C",
          "textRu": "Бассейн наполнится за $620 : 85$ часов",
          "textKk": "Бассейн $620 : 85$ сағатта толады",
