    {
      "localId": "q03",
      "type": "SCQ",
      "difficulty": 2,
      "needsIllustration": false,
      "sourceRuleIds": [
        "PDF_p25_2",
        "PDF_p24_1"
      ],
      "bodyRu": "Что значит умножить число $a$ на натуральное число $b$?",
      "bodyKk": "$a$ санын натурал $b$ санына көбейту нені білдіреді?",
      "explanationRu": "Нужно найти сумму $b$ слагаемых, каждое из которых равно $a$.",
      "explanationKk": "Әрқайсысы $a$-ға тең $b$ қосылғыштың қосындысын табу керек.",
      "source": "Алдамуратова, 5 кл, ч.1, стр. 24-27",
      "options": [
        {
          "label": "A",
          "textRu": "найти сумму $a$ и $b$",
          "textKk": "$a$ мен $b$ қосындысын табу",
          "correct": false
        },
        {
          "label": "B",
          "textRu": "найти сумму $b$ слагаемых, равных $a$",
          "textKk": "әрқайсысы $a$-ға тең $b$ қосылғыштың қосындысын табу",
          "correct": true
        },
        {
          "label": "C",
          "textRu": "найти разность $a$ и $b$",
          "textKk": "$a$ мен $b$ айырмасын табу",
          "correct": false
        },
        {
          "label": "D",
          "textRu": "найти частное $a : b$",
          "textKk": "$a : b$ жекешесін табу",
          "correct": false
        }
      ],
      "fillAnswers": [],
      "illustration": null
    },
    {
      "localId": "q04",
      "type": "SCQ",
      "difficulty": 2,
      "needsIllustration": false,
      "sourceRuleIds": [
        "PDF_p25_4"
      ],
      "bodyRu": "Какое определение деления соответствует учебнику?",
      "bodyKk": "Бөлудің оқулықтағы анықтамасы қайсы?",
      "explanationRu": "Деление — действие, которым по значению произведения и одному множителю находят другой множитель.",
      "explanationKk": "Бөлу — көбейтіндінің мәні мен бір көбейткіш бойынша екінші көбейткішті табу әрекеті.",
      "source": "Алдамуратова, 5 кл, ч.1, стр. 24-27",
      "options": [
        {
          "label": "A",
          "textRu": "действие, которым находят сумму равных слагаемых",
          "textKk": "тең қосылғыштардың қосындысын табу әрекеті",
          "correct": false
        },
        {
          "label": "B",
          "textRu": "действие, которым по значению произведения и одному множителю находят другой множитель",
          "textKk": "көбейтіндінің мәні мен бір көбейткіш бойынша екінші көбейткішті табу әрекеті",
          "correct": true
        },
        {
          "label": "C",
          "textRu": "действие, которым находят разность двух чисел",
          "textKk": "екі санның айырмасын табу әрекеті",
          "correct": false
        },
        {
          "label": "D",
          "textRu": "действие, которым сравнивают два числа",
          "textKk": "екі санды салыстыру әрекеті",
          "correct": false
        }
      ],
      "fillAnswers": [],
      "illustration": null
    },
    {
      "localId": "q05",
      "type": "SCQ",
      "difficulty": 2,
      "needsIllustration": false,
      "sourceRuleIds": [
        "PDF_p25_7"
      ],
      "bodyRu": "Можно ли делить натуральное число на $0$?",
      "bodyKk": "Натурал санды $0$-ге бөлуге бола ма?",
      "explanationRu": "По учебнику: на $0$ делить нельзя.",
      "explanationKk": "Оқулық бойынша: $0$-ге бөлуге болмайды.",
      "source": "Алдамуратова, 5 кл, ч.1, стр. 24-27",
      "options": [
        {
          "label": "A",
          "textRu": "да, частное равно $0$",
          "textKk": "иә, жекеше $0$",
          "correct": false
        },
        {
          "label": "B",
          "textRu": "да, частное равно делимому",
          "textKk": "иә, жекеше бөлінгішке тең",
          "correct": false
        },
        {
          "label": "C",
          "textRu": "нет, на $0$ делить нельзя",
          "textKk": "жоқ, $0$-ге бөлуге болмайды",
          "correct": true
        },
        {
          "label": "D",
          "textRu": "да, если делимое тоже равно $0$",
          "textKk": "иә, егер бөлінгіш те $0$ болса",
          "correct": false
        }
      ],
      "fillAnswers": [],
      "illustration": null
    },
    {
      "localId": "q06",
      "type": "SCQ",
      "difficulty": 2,
      "needsIllustration": false,
      "sourceRuleIds": [
        "PDF_p25_3"
      ],
      "bodyRu": "При каком условии значение произведения равно $0$?",
      "bodyKk": "Көбейтіндінің мәні қашан $0$-ге тең?",
      "explanationRu": "Если хотя бы один множитель равен нулю, то $a \\cdot 0 = 0$.",
      "explanationKk": "Кем дегенде бір көбейткіш нөл болса, $a \\cdot 0 = 0$.",
      "source": "Алдамуратова, 5 кл, ч.1, стр. 24-27",
      "options": [
        {
          "label": "A",
          "textRu": "только если оба множителя равны $0$",
          "textKk": "тек екі көбейткіш те $0$ болса",
          "correct": false
        },
        {
          "label": "B",
          "textRu": "если хотя бы один множитель равен $0$",
          "textKk": "кем дегенде бір көбейткіш $0$ болса",
          "correct": true
        },
        {
          "label": "C",
          "textRu": "если сумма множителей равна $0$",
          "textKk": "көбейткіштер қосындысы $0$ болса",
          "correct": false
        },
        {
          "label": "D",
          "textRu": "только при делении на $0$",
          "textKk": "тек $0$-ге бөлгенде",
          "correct": false
        }
      ],
      "fillAnswers": [],
      "illustration": null
    },
