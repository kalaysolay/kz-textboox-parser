      "localId": "q10",
      "type": "SCQ",
      "difficulty": 3,
      "bodyRu": "Утверждение: число $5$ — корень уравнения $5x-8=22$. Верно ли это?",
      "bodyKk": "Тұжырым: $5$ саны — $5x-8=22$ теңдеуінің түбірі. Бұл дұрыс па?",
      "explanationRu": "Подстановка: $5\\cdot 5-8=17\\neq 22$. Утверждение неверно.",
      "explanationKk": "Қою: $5\\cdot 5-8=17\\neq 22$. Тұжырым дұрыс емес.",
      "source": "Алдамуратова, 5 кл, ч.1, стр. 48-53",
      "needsIllustration": false,
      "illustration": null,
      "options": [
        {
          "label": "A",
          "textRu": "Нет: при $x=5$ получается $17\\neq 22$",
          "textKk": "Жоқ: $x=5$ болғанда $17\\neq 22$ шығады",
          "correct": true
        },
        {
          "label": "B",
          "textRu": "Да: $5$ — коэффициент при $x$",
          "textKk": "Иә: $5$ — $x$-тің коэффициенті",
          "correct": false
        },
        {
          "label": "C",
          "textRu": "Да: $5\\cdot 5-8=22$",
          "textKk": "Иә: $5\\cdot 5-8=22$",
          "correct": false
        },
        {
          "label": "D",
          "textRu": "Нет: нужно упростить выражение $5x-8$ без равенства",
          "textKk": "Жоқ: $5x-8$ өрнегін теңдіксіз ықшамдау керек",
          "correct": false
        }
      ],
      "fillAnswers": [],
      "sourceRuleIds": [
        "PDF_p48_3"
      ]
