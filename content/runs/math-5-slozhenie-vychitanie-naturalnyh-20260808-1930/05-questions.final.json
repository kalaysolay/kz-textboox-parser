    },
    {
      "localId": "q16",
      "type": "SCQ",
      "difficulty": 5,
      "needsIllustration": false,
      "sourceRuleIds": [
        "PDF_p20_1",
        "KF_p23_assembled"
      ],
      "bodyRu": "Ученик записал столбиком: $456 + 378 = 724$. В каком разряде допущена ошибка, если правильно $456 + 378 = 834$?",
      "bodyKk": "Оқушы бағанмен жазды: $456 + 378 = 724$. Дұрысы $456 + 378 = 834$ болса, қай разрядта қате жіберілген?",
      "explanationRu": "Единицы: $6+8=14$ (пишем 4, перенос 1). Десятки: $5+7+1=13$ (пишем 3, перенос 1). Сотни: $4+3+1=8$. Ученик потерял перенос в сотни и получил $724$.",
      "explanationKk": "Бірлік: $6+8=14$. Ондық: $5+7+1=13$. Жүздік: $4+3+1=8$. Оқушы жүздікке тасымалды жоғалтқан.",
      "options": [
        {
          "label": "A",
          "textRu": "только в разряде единиц (без переноса)",
          "textKk": "тек бірліктерде (тасымалсыз)",
          "correct": false
        },
        {
          "label": "B",
          "textRu": "потерян перенос в разряд сотен",
          "textKk": "жүздіктер разрядына тасымал жоғалған",
          "correct": true
        },
        {
          "label": "C",
          "textRu": "ошибки нет, ответ $724$ верный",
          "textKk": "қате жоқ, $724$ дұрыс",
          "correct": false
        },
        {
          "label": "D",
          "textRu": "неверно выровнены разряды слагаемых",
          "textKk": "қосылғыштар разрядтары теңестірілмеген",
          "correct": false
        }
      ],
      "source": "Алдамуратова, 5 кл, ч.1, стр. 20-23",
      "illustration": null,
      "fillAnswers": []
    },
    {
