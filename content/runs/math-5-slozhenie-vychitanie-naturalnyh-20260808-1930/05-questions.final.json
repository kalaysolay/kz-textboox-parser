      "explanationRu": "$48 + 12 = 60$, $70 - 47 = 23$, значит больше сумма $48 + 12$.",
      "explanationKk": "$48 + 12 = 60$, $70 - 47 = 23$, демек $48 + 12$ үлкен.",
      "options": [
        {
          "label": "A",
          "textRu": "$70 - 47$",
          "textKk": "$70 - 47$",
          "correct": false
        },
        {
          "label": "B",
          "textRu": "$48 + 12$",
          "textKk": "$48 + 12$",
          "correct": true
        },
        {
          "label": "C",
          "textRu": "значения равны",
          "textKk": "мәндері тең",
          "correct": false
        },
        {
          "label": "D",
          "textRu": "сравнить нельзя",
          "textKk": "салыстыруға болмайды",
          "correct": false
        }
      ],
      "source": "Алдамуратова, 5 кл, ч.1, стр. 20-23",
