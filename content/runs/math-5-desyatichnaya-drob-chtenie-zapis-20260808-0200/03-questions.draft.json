          "correct": true
        },
        {
          "label": "C",
          "textRu": "Только число, меньшее единицы",
          "textKk": "Тек бірден кіші сан",
          "correct": false
        },
        {
          "label": "D",
          "textRu": "Число, записанное со знаком процента",
          "textKk": "Пайыз белгісімен жазылған сан",
          "correct": false
